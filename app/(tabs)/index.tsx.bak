import { StatusBar } from 'expo-status-bar';
import React, { useEffect, useState } from 'react';
import { Dimensions, Pressable, ScrollView, StyleSheet, Text, View } from 'react-native';

export default function HomeScreen() {
  // Curated emoji categories for babies/toddlers
  const emojiCategories = {
    faces: ['😊', '😄', '😆', '🥰', '😍', '🤗', '😋', '😎', '🤪', '😴', '😂', '🤣', '😇', '🙂', '🥳', '🤩', '😘', '😚', '🤭'],
    nature: ['🌞', '⭐', '🌙', '🌈', '🌸', '🌺', '🌻', '🌳', '🍄', '⛅', '🌟', '💫', '☀️', '🌿', '🌱', '🍀', '🌷', '🌼', '🦋', '🌊'],
    transportation: ['🚗', '🚕', '🚙', '🚌', '🚎', '🛻', '🚂', '✈️', '🚁', '🛳️', '🚲', '🛴', '🏍️', '🚜', '🚒', '🚑', '🚓', '🛥️', '🚤', '🛸'],
    food: ['🍎', '🍌', '🍓', '🍊', '🍇', '🥕', '🍞', '🥛', '🍪', '🧁', '🍒', '🍑', '🥭', '🍍', '🥥', '🍉', '🥖', '🧀', '🥚', '🍯'],
    animals: ['🐶', '🐱', '🐭', '🐹', '🐰', '🦊', '🐻', '🐼', '🐸', '🐛', '🐯', '🦁', '🐨', '🐵', '🐔', '🐧', '🐦', '🐤', '🐢', '🦒', '🐘', '🐮', '🐷', '🐑', '🦆', '🐞', '🦋', '🐙', '🐬', '🐳']
  };

  // Flatten all emojis into one array
  const allEmojis = Object.values(emojiCategories).flat();

  const [currentEmojis, setCurrentEmojis] = useState<string[]>([]);
  const [selectedEmoji, setSelectedEmoji] = useState<string | null>(null);
  const [showLarge, setShowLarge] = useState(false);
  const [showIntro, setShowIntro] = useState(true);
  const [currentTooltip, setCurrentTooltip] = useState(0);

  // Tooltip content
  const tooltips = [
    {
      title: "Random Emojis Appear!",
      emoji: "☺️",
      description: "Invite your little one to tap away."
    },
    {
      title: "Learn Concepts",
      emoji: "🔷",
      description: "Talk about basic words and ideas."
    },
    {
      title: "Lock it Down",
      emoji: "🔒",
      description: "Set your phone to kid mode! Go to Guided Access in Settings > Accessibility."
    }
  ];

  // Background colors for each quadrant
  const backgroundColors = [
    '#FFB6E1', // pink
    '#ADD8E6', // light blue
    '#90EE90', // light green
    '#FFFFE0'  // light yellow
  ];

  // Generate 4 random emojis
  const generateRandomEmojis = (): string[] => {
    const shuffled = [...allEmojis].sort(() => Math.random() - 0.5);
    return shuffled.slice(0, 4);
  };

  // Initialize emojis on mount
  useEffect(() => {
    setCurrentEmojis(generateRandomEmojis());
  }, []);

  // Handle emoji click
  const handleEmojiClick = (emoji: string) => {
    setSelectedEmoji(emoji);
    setShowLarge(true);

    // After showing large emoji, generate new ones
    setTimeout(() => {
      setShowLarge(false);
      setSelectedEmoji(null);
      setTimeout(() => {
        setCurrentEmojis(generateRandomEmojis());
      }, 100);
    }, 1500);
  };

  // Handle next tooltip
  const nextTooltip = () => {
    if (currentTooltip < tooltips.length - 1) {
      setCurrentTooltip(currentTooltip + 1);
    } else {
      setShowIntro(false);
    }
  };

  // Skip intro
  const skipIntro = () => {
    setShowIntro(false);
  };

  const screenWidth = Dimensions.get('window').width;
  const boxSize = (screenWidth - 16) / 2; // 16 = padding

  if (showIntro) {
    return (
      <View style={[styles.container, { backgroundColor: '#E89EE0' }]}>
        <StatusBar barStyle="dark-content" />
        <ScrollView contentContainerStyle={styles.introContainer}>
          <View style={styles.introContent}>
            <Text style={styles.logoPlaceholder}>Peekmo</Text>
            <Text style={styles.subtitle}>Play Peekaboo with Emojis</Text>

            {/* Current Tooltip */}
            <View style={styles.tooltipCard}>
              <Text style={styles.tooltipLabel}>HOW IT WORKS</Text>
              <Text style={styles.tooltipEmoji}>{tooltips[currentTooltip].emoji}</Text>
              <Text style={styles.tooltipTitle}>{tooltips[currentTooltip].title}</Text>
              <Text style={styles.tooltipDescription}>{tooltips[currentTooltip].description}</Text>
            </View>

            {/* Progress dots */}
            <View style={styles.dotsContainer}>
              {tooltips.map((_, index) => (
                <View
                  key={index}
                  style={[
                    styles.dot,
                    index === currentTooltip ? styles.dotActive : styles.dotInactive
                  ]}
                />
              ))}
            </View>

            {/* Buttons */}
            <View style={styles.buttonContainer}>
              <Pressable
                style={({ pressed }) => [
                  styles.button,
                  styles.skipButton,
                  pressed && styles.buttonPressed
                ]}
                onPress={skipIntro}
              >
                <Text style={styles.skipButtonText}>SKIP</Text>
              </Pressable>
              <Pressable
                style={({ pressed }) => [
                  styles.button,
                  styles.nextButton,
                  pressed && styles.buttonPressed
                ]}
                onPress={nextTooltip}
              >
                <Text style={styles.nextButtonText}>NEXT</Text>
              </Pressable>
            </View>

            {/* Legal disclaimer */}
            <Text style={styles.legalText}>
              For entertainment only. Parental supervision required.{'\n'}
              Ages 2+. No personal data collected.{'\n'}
              © 2025 Peekmo™. All rights reserved.
            </Text>
          </View>
        </ScrollView>
      </View>
    );
  }

  // Large emoji overlay
  if (showLarge && selectedEmoji) {
    return (
      <View style={styles.largeEmojiContainer}>
        <Text style={styles.largeEmoji}>{selectedEmoji}</Text>
      </View>
    );
  }

  // Main game screen
  return (
    <View style={styles.container}>
      <StatusBar barStyle="dark-content" />
      
      {/* Top bar */}
      <View style={styles.topBar}>
        <Text style={styles.logoSmall}>Peekmo</Text>
      </View>

      {/* Main grid */}
      <View style={styles.gridContainer}>
        {currentEmojis.map((emoji, index) => (
          <Pressable
            key={`${emoji}-${index}-${Date.now()}`}
            style={({ pressed }) => [
              styles.emojiBox,
              {
                backgroundColor: backgroundColors[index],
                width: boxSize,
                height: boxSize,
              },
              pressed && styles.boxPressed
            ]}
            onPress={() => handleEmojiClick(emoji)}
          >
            <Text style={styles.emoji}>{emoji}</Text>
          </Pressable>
        ))}
      </View>

      {/* Legal footer */}
      <Text style={styles.footerText}>
        For entertainment only. Parental supervision required. Ages 2+. © 2025 Peekmo™. All rights reserved. Peekmo does not collect personal data.
      </Text>
    </View>
  );
}

const styles = StyleSheet.create({
  container: {
    flex: 1,
    backgroundColor: '#E89EE0',
  },
  
  // Intro screen styles
  introContainer: {
    flexGrow: 1,
    justifyContent: 'center',
    alignItems: 'center',
    paddingHorizontal: 24,
    paddingVertical: 40,
  },
  introContent: {
    width: '100%',
    maxWidth: 400,
    alignItems: 'center',
  },
  logoPlaceholder: {
    fontSize: 40,
    fontWeight: '700',
    marginBottom: 8,
    color: '#1e40af',
  },
  subtitle: {
    fontSize: 18,
    fontWeight: '500',
    marginBottom: 32,
    color: '#1f2937',
  },
  tooltipCard: {
    backgroundColor: '#ffffff',
    borderRadius: 24,
    padding: 32,
    marginBottom: 24,
    width: '100%',
    alignItems: 'center',
    shadowColor: '#000',
    shadowOffset: { width: 0, height: 4 },
    shadowOpacity: 0.15,
    shadowRadius: 8,
    elevation: 5,
  },
  tooltipLabel: {
    fontSize: 12,
    fontWeight: '600',
    color: '#1e40af',
    letterSpacing: 1,
    marginBottom: 16,
  },
  tooltipEmoji: {
    fontSize: 56,
    marginBottom: 16,
  },
  tooltipTitle: {
    fontSize: 20,
    fontWeight: '700',
    color: '#1e40af',
    marginBottom: 16,
  },
  tooltipDescription: {
    fontSize: 16,
    color: '#1e40af',
    lineHeight: 24,
    textAlign: 'center',
  },
  dotsContainer: {
    flexDirection: 'row',
    justifyContent: 'center',
    alignItems: 'center',
    marginBottom: 24,
    gap: 8,
  },
  dot: {
    width: 12,
    height: 12,
    borderRadius: 6,
  },
  dotActive: {
    backgroundColor: '#1e40af',
    width: 14,
    height: 14,
  },
  dotInactive: {
    backgroundColor: '#93c5fd',
  },
  buttonContainer: {
    flexDirection: 'row',
    gap: 16,
    marginBottom: 32,
  },
  button: {
    paddingHorizontal: 32,
    paddingVertical: 16,
    borderRadius: 24,
    justifyContent: 'center',
    alignItems: 'center',
  },
  skipButton: {
    backgroundColor: '#e9d5ff',
    borderWidth: 2,
    borderColor: '#1e40af',
  },
  nextButton: {
    backgroundColor: '#1e40af',
  },
  skipButtonText: {
    fontSize: 16,
    fontWeight: '700',
    color: '#1e40af',
  },
  nextButtonText: {
    fontSize: 16,
    fontWeight: '700',
    color: '#ffffff',
  },
  buttonPressed: {
    opacity: 0.8,
  },
  legalText: {
    fontSize: 12,
    color: '#374151',
    textAlign: 'center',
    lineHeight: 18,
    marginTop: 16,
  },

  // Game screen styles
  topBar: {
    backgroundColor: '#ffffff',
    paddingVertical: 12,
    paddingHorizontal: 16,
    alignItems: 'center',
    justifyContent: 'center',
    shadowColor: '#000',
    shadowOffset: { width: 0, height: 2 },
    shadowOpacity: 0.1,
    shadowRadius: 4,
    elevation: 3,
  },
  logoSmall: {
    fontSize: 18,
    fontWeight: '700',
    color: '#1e40af',
  },
  gridContainer: {
    flex: 1,
    flexDirection: 'row',
    flexWrap: 'wrap',
    padding: 12,
    gap: 8,
    justifyContent: 'space-around',
    alignContent: 'flex-start',
    alignItems: 'flex-start',
  },
  emojiBox: {
    borderRadius: 12,
    justifyContent: 'center',
    alignItems: 'center',
    borderWidth: 4,
    borderColor: '#ffffff',
    shadowColor: '#000',
    shadowOffset: { width: 0, height: 4 },
    shadowOpacity: 0.15,
    shadowRadius: 8,
    elevation: 4,
    width: '48%',
    height: '48%',
  },
  boxPressed: {
    opacity: 0.8,
    transform: [{ scale: 0.95 }],
  },
  emoji: {
    fontSize: 64,
  },

  // Large emoji overlay
  largeEmojiContainer: {
    flex: 1,
    backgroundColor: 'rgba(255, 255, 255, 0.9)',
    justifyContent: 'center',
    alignItems: 'center',
  },
  largeEmoji: {
    fontSize: 150,
  },

  // Footer
  footerText: {
    fontSize: 10,
    color: '#374151',
    textAlign: 'center',
    paddingHorizontal: 8,
    paddingBottom: 8,
    opacity: 0.7,
  },
});