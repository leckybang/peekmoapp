{
  "expo": {
    "name": "Peekmo",
    "slug": "peekmo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#E89EE0"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTabletMode": true,
      "bundleIdentifier": "com.ambiobranding.peekmo",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#E89EE0"
      },
      "package": "com.ambiobranding.peekmo"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "description": "Play Peekaboo with emojis! A fun, interactive game for toddlers.",
    "privacy": "https://www.ambiobranding.com/peekmo-privacy-policy",
    "extra": {
      "eas": {
        "projectId": "e5a11e02-1923-4af0-bb46-b73578d88f0d"
      }
    }
  }
}
